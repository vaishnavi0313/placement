# Optional: preconfigure the AI provider. Copy to `.env` and fill in.
# You can also set all of this from the "AI settings" button in the app.
#
# NOTE: VITE_* values are bundled into the browser build. Only use this for
# local/personal demos — for a public site, proxy AI calls through a server.

# demo | claude | gemini
VITE_AI_PROVIDER=demo

VITE_ANTHROPIC_API_KEY=
VITE_CLAUDE_MODEL=claude-opus-5-5

VITE_GEMINI_API_KEY=
VITE_GEMINI_MODEL=gemini-2.5-flash
